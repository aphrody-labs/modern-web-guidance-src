{
  "name": "modern-web-guidance-src",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "gd": "bin/gd.ts"
  },
  "scripts": {
    "postinstall": "bun src/core/postinstall.ts",
    "test": "bun test --timeout=120000 src",
    "test:e2e": "playwright test -c src/dashboard/playwright.config.js",
    "build": "bun src/build/build-guides.ts --target=skills-cli && bun run build-dist",
    "build-dist": "bun src/build/build-dist.ts",
    "build:guides": "bun run build",
    "build:devsite": "bun src/build/build-guides.ts --target=devsite --output=dist/devsite",
    "publish-skills": "bun src/build/publish-skills.ts",
    "collect-evals": "bun src/build/collect-eval-results.ts",
    "benchmark:rag": "bun src/rag/benchmarks/bench-rag.ts",
    "baselinestatus": "bun src/cli/baseline-status.ts",
    "typecheck": "bun check && bun check -p tsconfig.guides.json && bun check -p src/dashboard/tsconfig.json",
    "lint": "oxlint --ignore-path .oxlintignore",
    "preflight": "bun run build && bun run typecheck && bun run lint && bun run test",
    "suite": "bun src/harness/run-suite.ts",
    "qsmoke": "bun src/harness/quick-smoke.ts",
    "task": "bun src/harness/run-suite.ts",
    "report": "bun src/harness/evaluate.ts",
    "upload": "bun src/harness/upload-suite.ts",
    "public:build": "bun src/harness/public/build.ts",
    "public:publish": "bun src/harness/public/publish-cli.ts",
    "dashboard": "bun src/dashboard/generate-manifests.js && bun src/dashboard/server.js",
    "build:dashboard": "bun src/dashboard/generate-manifests.js --stage-pages",
    "deploy:dashboard": "bun run build:dashboard && gh-pages --nojekyll --add --dist out/dashboard-pages",
    "setup:playwright": "playwright install",
    "generate-grader": "bun src/grading/generate-grader.ts",
    "grade": "bun src/grading/run-grader.ts",
    "dev-guide": "bun src/authoring/dev.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.6",
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.325",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.4.5",
    "@types/gh-pages": "^6.1.0",
    "@types/omelette": "^0.4.5",
    "cssomnom": "^0.1.11",
    "diff": "^9.0.0",
    "esbuild": "^0.28.1",
    "gh-pages": "^6.3.0",
    "linkedom": "^0.18.12",
    "oxlint": "1.55.0",
    "playwright": "^1.58.2",
    "statikk": "^3.1.0",
    "ts-morph": "^27.0.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@google-cloud/storage": "^7.22.0",
    "@huggingface/transformers": "^4.3.1",
    "@mdn/browser-compat-data": "^8.1.7",
    "@openai/codex": "0.169.0",
    "@webref/css": "^8.7.0",
    "@webref/elements": "^2.7.1",
    "@webref/idl": "^3.82.0",
    "caniuse-lite": "1.0.30001806",
    "marked": "^18.0.3",
    "mdn-data": "2.29.0",
    "omelette": "^0.4.17",
    "web-features": "^3.46.0"
  },
  "trustedDependencies": [
    "esbuild",
    "onnxruntime-node",
    "protobufjs",
    "sharp",
    "@anthropic-ai/claude-code"
  ],
  "overrides": {
    "@tootallnate/once": "^3.0.1"
  }
}
